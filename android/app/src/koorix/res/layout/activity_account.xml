<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:elevation="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_logo_badge"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="K"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:text="Koorix"
                android:textColor="@color/white"
                android:textDirection="ltr"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="وەرگێڕی مانهوا بۆ کوردی سۆرانی"
                android:textColor="#E0F2FE"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/accountProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- Signed-out card -->
        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="بەخێر بێیت 👋"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingMultiplier="1.25"
                android:text="بچۆرە ژوورەوە یان هەژمارێکی خۆڕایی دروست بکە بۆ دەستپێکردنی وەرگێڕان."
                android:textColor="@color/text_secondary"
                android:textDirection="firstStrongRtl"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:hint="ئیمەیڵ (Gmail)"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:layoutDirection="ltr"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="وشەی نهێنی (لانی کەم ٦ پیت)"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:layoutDirection="ltr"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-black"
                android:minHeight="54dp"
                android:stateListAnimator="@null"
                android:text="چوونەژوورەوە"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/signUpButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-black"
                android:minHeight="54dp"
                android:stateListAnimator="@null"
                android:text="دروستکردنی هەژماری نوێ"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="یان"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />
            </LinearLayout>

            <Button
                android:id="@+id/googleButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-black"
                android:minHeight="54dp"
                android:stateListAnimator="@null"
                android:text="G  •  بەردەوامبوون بە Google"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/authMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/warning"
                android:textDirection="firstStrongRtl"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Signed-in card -->
        <LinearLayout
            android:id="@+id/accountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="👤 هەژمارەکەم"
                android:textColor="@color/text_primary"
                android:textDirection="firstStrongRtl"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/planStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_feature_tile"
                android:lineSpacingMultiplier="1.3"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_primary"
                android:textDirection="firstStrongRtl"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usageStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/text_secondary"
                android:textDirection="firstStrongRtl"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_divider_fade" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="💎 Premium"
                android:textColor="@color/text_primary"
                android:textDirection="firstStrongRtl"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premiumPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/koorix_premium_pitch"
                android:textColor="@color/text_secondary"
                android:textDirection="firstStrongRtl"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buyButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-black"
                android:minHeight="54dp"
                android:stateListAnimator="@null"
                android:text="🛒 کڕینی Premium"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="KOORIX-XXXX-XXXX"
                android:inputType="textCapCharacters"
                android:layoutDirection="ltr"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <Button
                android:id="@+id/redeemButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-black"
                android:minHeight="50dp"
                android:stateListAnimator="@null"
                android:text="چالاککردنی کۆد"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/accountMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/success"
                android:textDirection="firstStrongRtl"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/backToAppButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-black"
                android:minHeight="54dp"
                android:stateListAnimator="@null"
                android:text="🚀 دەستپێکردنی وەرگێڕان"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/signOutButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_danger"
                android:fontFamily="sans-serif-black"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="چوونەدەرەوە"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
