<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/page</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorButtonNormal">@color/card_soft</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.Koorix.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ui_secondary_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Koorix.Button.Primary" parent="Widget.Koorix.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ui_primary_text</item>
    </style>
    <style name="Widget.Koorix.Button.Danger" parent="Widget.Koorix.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/ui_danger</item>
    </style>
    <style name="Widget.Koorix.Button.Navigation" parent="Widget.Koorix.Button">
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="Widget.Koorix.Body" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:includeFontPadding">true</item>
    </style>
    <style name="Widget.Koorix.Label" parent="Widget.Koorix.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Koorix.Title" parent="Widget.Koorix.Label">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Widget.Koorix.Input" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:includeFontPadding">true</item>
    </style>
    <style name="Widget.Koorix.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">28dp</item>
    </style>
    <style name="Widget.Koorix.Check" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:buttonTint">@color/primary</item>
    </style>
</resources>