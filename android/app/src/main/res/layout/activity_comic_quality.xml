<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page" android:orientation="vertical" android:fitsSystemWindows="false" android:paddingHorizontal="16dp" android:id="@+id/qualityRoot" android:layoutDirection="locale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">
        <Button android:id="@+id/qualityBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comic_back" android:textAllCaps="false" android:paddingHorizontal="14dp" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" android:minHeight="48dp" android:minWidth="48dp" android:includeFontPadding="true" style="@style/Widget.Koorix.Button" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/q_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" android:includeFontPadding="true" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/q_badge" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" android:includeFontPadding="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/q_intro" android:textSize="13sp" android:lineSpacingMultiplier="1.15" android:textColor="@color/text_secondary" android:includeFontPadding="true" />
    <TextView android:id="@+id/qualityPair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textDirection="ltr" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/qualitySettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/q_settings" android:textAllCaps="false" android:textSize="12sp" android:paddingHorizontal="8dp" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" android:minHeight="48dp" android:minWidth="48dp" android:includeFontPadding="true" style="@style/Widget.Koorix.Button" />
        <Button android:id="@+id/qualityGuide" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/q_guide_button" android:textAllCaps="false" android:textSize="12sp" android:paddingHorizontal="8dp" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" android:minHeight="48dp" android:minWidth="48dp" android:includeFontPadding="true" style="@style/Widget.Koorix.Button" />
    </LinearLayout>
    <TextView android:id="@+id/qualityStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card_accent" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingMultiplier="1.15" android:accessibilityLiveRegion="polite" android:includeFontPadding="true" />
    <com.kurdman.app.ReadingPairLayout android:id="@+id/qualitySelectors" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Spinner android:id="@+id/qualityPage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/bg_spinner" android:spinnerMode="dropdown" android:contentDescription="@string/q_choose_page" android:minHeight="48dp" android:paddingEnd="28dp" />
        <Spinner android:id="@+id/qualityFilter" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_spinner" android:spinnerMode="dropdown" android:contentDescription="@string/q_all" android:minHeight="48dp" android:paddingEnd="28dp" />
    </com.kurdman.app.ReadingPairLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
        <ListView android:id="@+id/qualityList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:clipToPadding="false" android:paddingBottom="8dp" android:scrollbars="vertical" />
        <TextView android:id="@+id/qualityEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="20dp" android:textSize="15sp" android:lineSpacingMultiplier="1.25" android:textColor="@color/text_secondary" android:text="@string/q_no_project" android:includeFontPadding="true" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/q_limits" android:textColor="@color/text_muted" android:textSize="11sp" android:lineSpacingMultiplier="1.1" android:layout_marginVertical="6dp" android:includeFontPadding="true" />
    <Button android:id="@+id/qualityExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_button_primary" android:text="@string/q_export" android:textAllCaps="false" android:textSize="13sp" android:textColor="@color/text_on_primary" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:includeFontPadding="true" style="@style/Widget.Koorix.Button.Primary" />
</LinearLayout>