<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Compact header: the title is never squeezed by the action buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2070D18"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editorBackButton"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="داخستنی ستۆدیۆکە"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="✕"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="ستۆدیۆی دەق"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/editorPageLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="لاپەڕە ١/١"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/editorBlockLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="هیچ دەقێک نییە"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/editorUndoButton"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="هەڵگەڕاندنەوە"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="↶"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorRedoButton"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="دووبارەکردنەوە"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="↷"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorSaveButton"
                android:layout_width="58dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="پاشەکەوتکردن و دەرکردن"
                android:fontFamily="sans-serif-black"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="✓"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/editorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:minHeight="34dp"
            android:paddingStart="11dp"
            android:paddingTop="6dp"
            android:paddingEnd="11dp"
            android:paddingBottom="6dp"
            android:text="بارکردنی پرۆژەکە…"
            android:textColor="@color/text_primary"
            android:textDirection="firstStrongRtl"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The page is now the main thing on screen. Page/block controls are
         small overlays, so they do not steal a large slice of the editor. -->
    <FrameLayout
        android:id="@+id/editorCanvasFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#020617">

        <com.kurdman.app.PageEditorView
            android:id="@+id/editorCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#020617" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="7dp"
            android:layout_marginTop="7dp"
            android:background="#D9070D18"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="لاپەڕە"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/editorPagePrevButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="لاپەڕەی پێشوو"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorPageNextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="لاپەڕەی دواتر"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="›"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorBlockListButton"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="لیستی دەقەکان"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="☰"
                android:textAllCaps="false"
                android:textColor="#5EEAD4"
                android:textSize="18sp" />

            <Button
                android:id="@+id/editorFitButton"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="گونجاندن بە پانایی شاشە"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="⛶"
                android:textAllCaps="false"
                android:textColor="#5EEAD4"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="7dp"
            android:background="#D9070D18"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="دەق"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/editorBlockPrevButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="دەقی پێشوو"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorBlockNextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="دەقی دواتر"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="›"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorZoomOutButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="زووم بچووک بکە"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorZoomInButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="زووم گەورە بکە"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/editorPeekButton"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="پەنجە لەسەر دابنێ بۆ بینینی وێنە ڕەسەنەکە"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="👁"
                android:textAllCaps="false"
                android:textColor="#C4B5FD"
                android:textSize="17sp" />
        </LinearLayout>

        <Button
            android:id="@+id/editorShowControlsButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_primary"
            android:minHeight="50dp"
            android:minWidth="118dp"
            android:stateListAnimator="@null"
            android:text="☰  کۆنترۆڵەکان"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Detailed tabs exist only after Advanced is deliberately opened. -->
    <HorizontalScrollView
        android:id="@+id/editorTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6070D18"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/editorTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp" />
    </HorizontalScrollView>

    <!-- Only one studio section is visible at a time. -->
    <ScrollView
        android:id="@+id/editorPanelScroll"
        android:layout_width="match_parent"
        android:layout_height="198dp"
        android:background="#F2070D18"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/editorPanelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="#F2070D18"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="6dp"
        android:paddingEnd="7dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/editorSectionTextsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:lineSpacingMultiplier="1.02"
            android:minHeight="50dp"
            android:minWidth="0dp"
            android:padding="2dp"
            android:stateListAnimator="@null"
            android:text="١&#10;دەقەکان"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/editorSectionPositionButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:lineSpacingMultiplier="1.02"
            android:minHeight="50dp"
            android:minWidth="0dp"
            android:padding="2dp"
            android:stateListAnimator="@null"
            android:text="٢&#10;شوێن"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/editorSectionStyleButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:lineSpacingMultiplier="1.02"
            android:minHeight="50dp"
            android:minWidth="0dp"
            android:padding="2dp"
            android:stateListAnimator="@null"
            android:text="٣&#10;ستایل"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/editorSectionFinishButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:lineSpacingMultiplier="1.02"
            android:minHeight="50dp"
            android:minWidth="0dp"
            android:padding="2dp"
            android:stateListAnimator="@null"
            android:text="٤&#10;دەرکردن"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
