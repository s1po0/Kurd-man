<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0B1321" />
            <stroke
                android:width="1.2dp"
                android:color="#243650"
                android:dashGap="7dp"
                android:dashWidth="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#14333C" />
            <stroke
                android:width="1.4dp"
                android:color="@color/primary"
                android:dashGap="7dp"
                android:dashWidth="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0F1C2E" />
            <stroke
                android:width="1.2dp"
                android:color="#2DD4BF"
                android:dashGap="7dp"
                android:dashWidth="9dp" />
        </shape>
    </item>
</selector>
