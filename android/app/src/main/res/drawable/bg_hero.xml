<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="135"
                android:centerColor="#0E7490"
                android:endColor="#6D28D9"
                android:startColor="#0F766E" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
    <item
        android:width="170dp"
        android:height="170dp"
        android:gravity="top|end"
        android:right="-55dp"
        android:top="-72dp">
        <shape android:shape="oval">
            <solid android:color="#24FFFFFF" />
        </shape>
    </item>
    <item
        android:width="92dp"
        android:height="92dp"
        android:bottom="-38dp"
        android:gravity="bottom|start"
        android:left="-28dp">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
