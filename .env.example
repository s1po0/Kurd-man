# TELEGRAM_BOT_TOKEN: from @BotFather in Telegram (/newbot). Like a password —
# keep it ONLY in your real .env or hosting/GitHub Secrets. NEVER commit it.
# Leaked? @BotFather -> /revoke
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_ADMIN_ID: YOUR numeric Telegram user ID (from @userinfobot).
# Only this account can use admin commands like /status.
TELEGRAM_ADMIN_ID=""

# TELEGRAM_ADMIN_ONLY: "true" = bot answers ONLY the admin (fully private bot).
TELEGRAM_ADMIN_ONLY="false"
